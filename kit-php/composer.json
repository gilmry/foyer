{
    "name": "foyer/kit-php",
    "description": "Kit Foyer PHP hexagonal — adaptateurs de persistance enfichables (CQRS SQL ↔ Doctrine).",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^4.2",
        "symfony/cache": "^7.2",
        "api-platform/core": "^4.3",
        "symfony/framework-bundle": "^7.2",
        "symfony/runtime": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "TodoApp\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    }
}
